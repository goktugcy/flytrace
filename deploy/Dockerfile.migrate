# syntax=docker/dockerfile:1.7
#
# One-shot migration job.
#
#   docker build -f deploy/Dockerfile.migrate -t flytrace/migrate .
#
# Deliberately a SEPARATE image and a separate container from the services.
# Application instances must never run migrations at boot: with N replicas that
# is N concurrent schema changes racing each other, and a failed migration
# becomes a partially-migrated database that half the fleet is already writing
# to. Here exactly one container runs the migrator, exits 0 or non-zero, and the
# services are gated on that exit code (see docker-compose.production.yml).
#
# `src/migrate.ts` additionally takes a Postgres advisory lock, so even two
# migration jobs started by accident serialise instead of colliding.
#
# The runner is bundled (like the services) rather than shipped as source with a
# node_modules tree: a workspace install here would drag in every app's
# dependencies — including Next.js — for a job that only talks to Postgres.

# ──────────────────────────────────────────────────────────── deps ──
FROM oven/bun:1.3.14-alpine AS deps
WORKDIR /repo

COPY package.json bun.lock ./
COPY apps/api/package.json                 apps/api/
COPY apps/tracker/package.json             apps/tracker/
COPY apps/worker/package.json              apps/worker/
COPY apps/notifier/package.json            apps/notifier/
COPY apps/web/package.json                 apps/web/
COPY packages/shared/package.json          packages/shared/
COPY packages/db/package.json              packages/db/
COPY packages/providers/package.json       packages/providers/
COPY packages/notifications/package.json   packages/notifications/
COPY packages/airspace/package.json        packages/airspace/
COPY packages/airport-ops/package.json     packages/airport-ops/
# Test-only workspace. Its manifest must be present or the frozen lockfile
# will not validate; no test source ever reaches an image (see .dockerignore).
COPY tests/integration/package.json        tests/integration/

RUN bun install --frozen-lockfile

# ─────────────────────────────────────────────────────────── build ──
FROM deps AS build
WORKDIR /repo

COPY tsconfig.base.json ./
COPY packages/ packages/

RUN cd packages/db && bun run build:migrate && test -f dist/migrate.js

# ───────────────────────────────────────────────────────── runtime ──
FROM oven/bun:1.3.14-alpine AS runtime
RUN apk add --no-cache tini

ENV NODE_ENV=production \
    APP_ENV=production \
    BUN_INSTALL_CACHE_DIR=/tmp/.bun-cache \
    HOME=/tmp

WORKDIR /app

# The bundle resolves its SQL via `new URL('../migrations', import.meta.url)`,
# so the folder must sit one level above the bundle: /app/migrations.
COPY --from=build --chown=root:root /repo/packages/db/dist/migrate.js     ./dist/migrate.js
COPY --from=build --chown=root:root /repo/packages/db/dist/migrate.js.map ./dist/migrate.js.map
COPY --chown=root:root packages/db/migrations ./migrations

USER bun

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["bun", "run", "/app/dist/migrate.js"]
