# ─────────────────────────────────────────────────────────────────────────────
# FlyTrace — production environment.
#
#   cp deploy/env/production.env.example .env.production
#   # fill in every REQUIRED value
#   docker compose -f docker-compose.production.yml --env-file .env.production up -d
#
# Every value marked REQUIRED has no default and `docker compose up` will refuse
# to start without it. That is deliberate: a missing secret should stop a deploy,
# not produce a silently insecure one.
#
# Generate secrets with:  openssl rand -hex 32
# Never commit the filled-in file. Prefer your platform's secret store and inject
# these as environment variables rather than keeping a file on disk.
# ─────────────────────────────────────────────────────────────────────────────

# ── images ──
IMAGE_PREFIX=flytrace
IMAGE_TAG=latest
GIT_SHA=unknown

# ── REQUIRED: database ──
POSTGRES_USER=flytrace
POSTGRES_PASSWORD=            # REQUIRED — openssl rand -hex 32
POSTGRES_DB=flytrace
# Must match the three values above. Host is the compose service name.
DATABASE_URL=postgres://flytrace:CHANGE_ME@postgres:5432/flytrace

# Postgres tuning. max_connections must exceed the SUM of every pool plus a
# reserve for maintenance — see docs/18-production.md §Connection budget.
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_LOG_MIN_DURATION_MS=1000

# Per-service pool sizes (these are what add up against PG_MAX_CONNECTIONS).
API_DB_POOL_MAX=10
TRACKER_DB_POOL_MAX=5
WORKER_DB_POOL_MAX=5
NOTIFIER_DB_POOL_MAX=5

# ── REQUIRED: redis ──
REDIS_PASSWORD=               # REQUIRED — openssl rand -hex 32
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_MAXMEMORY=1gb

# ── REQUIRED: auth & security ──
# Signs WebSocket tickets and, unless MFA_SECRET_ENCRYPTION_KEY is set, also
# derives the MFA secret encryption key.
AUTH_SECRET=                  # REQUIRED — openssl rand -hex 32
AUTH_URL=https://api.example.com
# Encrypts stored TOTP secrets at rest. Set it explicitly so it can be rotated
# independently of AUTH_SECRET.
MFA_SECRET_ENCRYPTION_KEY=    # REQUIRED — openssl rand -hex 32
# Guards /metrics and /health/detailed. Minimum 32 characters; the API REFUSES
# to boot without it outside local development.
INTERNAL_API_TOKEN=           # REQUIRED — openssl rand -hex 32

# Browser origins allowed to call the API (comma-separated, exact match).
CORS_ORIGINS=https://app.example.com
WEB_BASE_URL=https://app.example.com

# Cookies. Set the domain only if the web app and API are on different
# subdomains of the same site (e.g. `.example.com`). SameSite=None requires a
# genuine cross-SITE split and weakens CSRF defence to the Origin check alone.
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=Lax
SESSION_TTL_DAYS=30
SESSION_REFRESH_TTL_DAYS=30
# Re-presenting a just-rotated refresh token within this window counts as an
# in-flight retry rather than an attack. 0 disables the grace entirely.
REFRESH_TOKEN_REUSE_GRACE_MS=10000

# MFA. `memory` is REJECTED at boot in production: a process-local challenge
# store breaks sign-in across replicas.
MFA_CHALLENGE_BACKEND=redis
MFA_CHALLENGE_TTL_SECONDS=300
MFA_MAX_ATTEMPTS=5
MFA_ISSUER=FlyTrace

# How much of a client address is persisted: prefix (/24, /48) | full | none.
SECURITY_IP_STORAGE=prefix
SECURITY_NOTIFICATIONS_ENABLED=true
LINK_TOKEN_TTL_MINUTES=1440

# ── rate limiting ──
# `memory` is REJECTED at boot in production: per-process counters multiply
# every limit by the replica count.
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=300000
RATE_LIMIT_SIGNUP_MAX=5
RATE_LIMIT_SIGNUP_WINDOW_MS=3600000
RATE_LIMIT_MFA_CHALLENGE_MAX=10
RATE_LIMIT_MFA_CHALLENGE_WINDOW_MS=300000
RATE_LIMIT_MFA_VERIFY_MAX=10
RATE_LIMIT_MFA_VERIFY_WINDOW_MS=300000
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_REFRESH_WINDOW_MS=300000
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=3600000
RATE_LIMIT_WS_TICKET_MAX=30
RATE_LIMIT_WS_TICKET_WINDOW_MS=60000
RATE_LIMIT_SECURITY_MAX=20
RATE_LIMIT_SECURITY_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=60
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_OPS_MAX=120
RATE_LIMIT_OPS_WINDOW_MS=60000

# ── audit & CSP ──
AUDIT_BACKEND=db
CSP_MODE=enforce
CSP_REPORT_URI=/api/v1/security/csp-report

# ── bot protection (optional) ──
TURNSTILE_ENABLED=false
TURNSTILE_SECRET=
TURNSTILE_FAIL_OPEN=false
NEXT_PUBLIC_TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── web (build-time; INLINED INTO THE CLIENT BUNDLE — never secrets) ──
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_WS_URL=wss://api.example.com/ws

# ── notification channels (optional) ──
EMAIL_PROVIDER=resend         # mock | resend | brevo | smtp
EMAIL_API_KEY=
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_FROM=FlyTrace <alerts@example.com>
BREVO_API_KEY=
SMTP_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ops@example.com
DIGEST_ENABLED=false

# ── tracker feed ──
TRACKER_SOURCE=adsb
TRACKER_BBOX=35.0,25.0,43.0,45.0
ADSB_API_URL=https://api.adsb.lol/v2
ADSB_CENTER_LAT=39.0
ADSB_CENTER_LON=35.0
ADSB_RADIUS_NM=250
ADSB_POLL_INTERVAL_MS=5000
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ── worker ──
WORKER_PROVIDER_FETCH_SCOPE=watched
AERODATABOX_API_KEY=
BACKUP_PROVIDER=pgdump

# ── operations ──
LOG_LEVEL=info
SECURITY_JANITOR_INTERVAL_MS=3600000
MIGRATION_LOCK_TIMEOUT_MS=120000

# ── proxy ──
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=./deploy/nginx/certs

# ── resource limits ──
API_CPU_LIMIT=2
API_MEMORY_LIMIT=1g
WEB_CPU_LIMIT=1
WEB_MEMORY_LIMIT=768m
TRACKER_CPU_LIMIT=1
TRACKER_MEMORY_LIMIT=768m
WORKER_CPU_LIMIT=1
WORKER_MEMORY_LIMIT=768m
NOTIFIER_CPU_LIMIT=1
NOTIFIER_MEMORY_LIMIT=512m
PG_CPU_LIMIT=2
PG_MEMORY_LIMIT=2g
REDIS_CPU_LIMIT=1
REDIS_MEMORY_LIMIT=1500m
PROXY_CPU_LIMIT=1
PROXY_MEMORY_LIMIT=256m
