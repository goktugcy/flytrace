# syntax=docker/dockerfile:1.7
#
# Next.js web app.
#
#   docker build -f deploy/Dockerfile.web -t flytrace/web .
#
# Uses Next's `output: 'standalone'` tracing: the runtime layer receives only
# the server bundle and the node_modules Next proved are reachable, not the
# workspace. That is what keeps this image small without hand-pruning.
#
# NEXT_PUBLIC_* values are INLINED INTO THE CLIENT BUNDLE at build time, so they
# are build args, not runtime env — and consequently must never hold a secret.
# Everything server-side is read from the environment at run time.

# ──────────────────────────────────────────────────────────── deps ──
FROM oven/bun:1.3.14-alpine AS deps
WORKDIR /repo

COPY package.json bun.lock ./
COPY apps/api/package.json                 apps/api/
COPY apps/tracker/package.json             apps/tracker/
COPY apps/worker/package.json              apps/worker/
COPY apps/notifier/package.json            apps/notifier/
COPY apps/web/package.json                 apps/web/
COPY packages/shared/package.json          packages/shared/
COPY packages/db/package.json              packages/db/
COPY packages/providers/package.json       packages/providers/
COPY packages/notifications/package.json   packages/notifications/
COPY packages/airspace/package.json        packages/airspace/
COPY packages/airport-ops/package.json     packages/airport-ops/
# Test-only workspace. Its manifest must be present or the frozen lockfile
# will not validate; no test source ever reaches an image (see .dockerignore).
COPY tests/integration/package.json        tests/integration/

RUN bun install --frozen-lockfile

# ─────────────────────────────────────────────────────────── build ──
FROM deps AS build
WORKDIR /repo

# Public, non-secret configuration baked into the client bundle.
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ARG NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
ARG NEXT_PUBLIC_TURNSTILE_ENABLED=false
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ARG NEXT_PUBLIC_MAP_STYLE=
ARG CSP_MODE=enforce

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL} \
    NEXT_PUBLIC_TURNSTILE_ENABLED=${NEXT_PUBLIC_TURNSTILE_ENABLED} \
    NEXT_PUBLIC_TURNSTILE_SITE_KEY=${NEXT_PUBLIC_TURNSTILE_SITE_KEY} \
    NEXT_PUBLIC_MAP_STYLE=${NEXT_PUBLIC_MAP_STYLE} \
    CSP_MODE=${CSP_MODE} \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

COPY tsconfig.base.json ./
COPY packages/ packages/
COPY apps/web/ apps/web/

RUN cd apps/web && bun run build && test -d .next/standalone

# ───────────────────────────────────────────────────────── runtime ──
FROM node:22-alpine AS runtime
ARG APP_VERSION=dev
ARG GIT_SHA=unknown

RUN apk add --no-cache tini wget

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    APP_VERSION=${APP_VERSION} \
    GIT_SHA=${GIT_SHA} \
    PORT=3000 \
    HOSTNAME=0.0.0.0

WORKDIR /app

# node:alpine ships an unprivileged `node` user (uid 1000).
# `.next/standalone` already contains a minimal node_modules; static assets and
# `public/` are copied separately because tracing does not include them.
COPY --from=build --chown=root:root /repo/apps/web/.next/standalone ./
COPY --from=build --chown=root:root /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=root:root /repo/apps/web/public ./apps/web/public

USER node

EXPOSE 3000
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/web/server.js"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:3000/ || exit 1

LABEL org.opencontainers.image.title="flytrace-web" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}"
