{
  "name": "@flytrace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate && bun run scripts/fix-postgis-migration.ts",
    "db:migrate": "bun run src/migrate.ts",
    "db:seed": "bun run src/seed.ts",
    "airlines:import": "bun run src/import-airlines.ts",
    "airports:import": "bun run src/import-airports.ts",
    "airspace:import": "bun run src/import-airspace.ts",
    "airport-geo:import": "bun run src/import-airport-osm.ts",
    "airport-runways:import": "bun run src/import-airport-runways.ts",
    "db:studio": "drizzle-kit studio",
    "test": "bun test",
    "build": "tsc --noEmit",
    "build:migrate": "bun build src/migrate.ts --target=bun --outdir=dist --sourcemap=linked --minify"
  },
  "dependencies": {
    "@flytrace/airspace": "workspace:*",
    "@flytrace/shared": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.3"
  }
}
