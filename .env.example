# ─────────────────────────────────────────────────────────────
# FlyTrace — environment variables (copy to .env and fill in)
# Never commit .env. Only NEXT_PUBLIC_* values reach the browser.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
APP_ENV=local            # local | staging | production
LOG_LEVEL=debug          # trace | debug | info | warn | error

# Database (Postgres + PostGIS)
DATABASE_URL=postgres://flytrace:flytrace@localhost:5432/flytrace

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
API_HOST=0.0.0.0
# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Auth (Better Auth) — set strong random values in real environments
AUTH_SECRET=dev-only-change-me-please-32chars-min
AUTH_URL=http://localhost:3001

# OpenSky Network (OAuth2 client credentials) — fill in later
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_POLL_INTERVAL_MS=6000

# Tracker live feed + stale lifecycle
TRACKER_SOURCE=adsb        # adsb | opensky | composite | fixture
TRACKER_PROVIDERS=opensky,adsb
TRACKER_PROVIDER_PRIORITY=adsb:20,opensky:10
TRACKER_PROVIDER_SWITCH_MARGIN=0.15
TRACKER_PROVIDER_MAX_JUMP_SPEED_KT=1200
TRACKER_BBOX=35.0,25.0,43.0,45.0
TRACKER_LIVE_AFTER_MS=15000
TRACKER_DELAYED_AFTER_MS=30000
TRACKER_STALE_AFTER_MS=60000
TRACKER_REMOVE_AFTER_MS=90000
TRACKER_MAX_POSITION_AGE_MS=30000
ADSB_API_URL=https://api.adsb.lol/v2
ADSB_CENTER_LAT=39.0
ADSB_CENTER_LON=35.0
ADSB_RADIUS_NM=250
ADSB_POLL_INTERVAL_MS=5000

# Web Push (VAPID) — generate with: bunx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ops@flytrace.local

# Frontend (public)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
