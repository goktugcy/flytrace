# ─────────────────────────────────────────────────────────────
# FlyTrace — environment variables (copy to .env and fill in)
# Never commit .env. Only NEXT_PUBLIC_* values reach the browser.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
APP_ENV=local            # local | staging | production
LOG_LEVEL=debug          # trace | debug | info | warn | error

# Database (Postgres + PostGIS)
DATABASE_URL=postgres://flytrace:flytrace@localhost:5432/flytrace
DB_POOL_MODE=session          # session | transaction
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_STATEMENT_TIMEOUT_MS=30000
PG_PREPARE=true

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PUBSUB_MODE=standard   # standard | sharded

# WebSocket scaling
WS_PUBSUB_BACKEND=memory      # memory | redis
WS_PRESENCE_BACKEND=memory    # memory | redis
WS_RATELIMIT_BACKEND=memory
WS_SHARD_COUNT=64
WS_HEARTBEAT_INTERVAL_MS=15000
WS_MAX_CONNS_PER_IP=10
WS_MAX_MSGS_PER_SEC=20

# API
API_PORT=3001
API_HOST=0.0.0.0
# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Auth — set strong random values in real environments (openssl rand -hex 32)
AUTH_SECRET=dev-only-change-me-please-32chars-min
AUTH_URL=http://localhost:3001

# ── Sessions, refresh tokens, cookies ──
# Session and refresh tokens are stored HASHED (SHA-256); the raw value only
# ever lives in the cookie. See docs/18-production.md §Auth.
SESSION_TTL_DAYS=30
SESSION_REFRESH_TTL_DAYS=30
# Re-presenting a just-rotated refresh token inside this window is treated as an
# in-flight retry (rejected, family kept); past it, as reuse (everything burned).
# 0 disables the grace window entirely.
REFRESH_TOKEN_REUSE_GRACE_MS=10000
SESSION_COOKIE_SAMESITE=Lax   # Lax | Strict | None (None forces Secure)
SESSION_COOKIE_DOMAIN=        # e.g. .example.com to share across subdomains
# How much of a client address is persisted: prefix (/24, /48) | full | none.
SECURITY_IP_STORAGE=prefix
SECURITY_NOTIFICATIONS_ENABLED=true
# Lifetime of email-verification and Telegram deep-link tokens (minutes).
LINK_TOKEN_TTL_MINUTES=1440

# ── MFA ──
MFA_ISSUER=FlyTrace
MFA_SECRET_ENCRYPTION_KEY=    # optional; falls back to AUTH_SECRET when unset
# Where login-time MFA challenges live. `memory` is REJECTED at boot in
# production — a process-local store breaks sign-in across replicas.
MFA_CHALLENGE_BACKEND=memory  # redis | memory
MFA_CHALLENGE_TTL_SECONDS=300 # clamped to 60–600
MFA_MAX_ATTEMPTS=5

# ── Operational endpoints (/metrics, /health/detailed) ──
# REQUIRED outside local development: without it the API refuses to boot rather
# than leaving these endpoints publicly readable. Minimum 32 characters.
INTERNAL_API_TOKEN=
# Set true only when access is already restricted at the network layer.
INTERNAL_ENDPOINTS_NETWORK_ONLY=false

# ── Rate limiting ──
# `memory` is REJECTED at boot in production: per-process counters multiply
# every limit by the replica count.
RATE_LIMIT_BACKEND=memory     # memory | redis
RATE_LIMIT_MAX=100            # general /api/* budget
RATE_LIMIT_WINDOW_MS=60000
# Per-category policies. Credential endpoints are fail-CLOSED: if the shared
# counter is unavailable they reject rather than serve unlimited guesses.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=300000
RATE_LIMIT_SIGNUP_MAX=5
RATE_LIMIT_SIGNUP_WINDOW_MS=3600000
RATE_LIMIT_MFA_CHALLENGE_MAX=10
RATE_LIMIT_MFA_CHALLENGE_WINDOW_MS=300000
RATE_LIMIT_MFA_VERIFY_MAX=10
RATE_LIMIT_MFA_VERIFY_WINDOW_MS=300000
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_REFRESH_WINDOW_MS=300000
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=3600000
RATE_LIMIT_WS_TICKET_MAX=30
RATE_LIMIT_WS_TICKET_WINDOW_MS=60000
RATE_LIMIT_SECURITY_MAX=20
RATE_LIMIT_SECURITY_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=60
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_OPS_MAX=120
RATE_LIMIT_OPS_WINDOW_MS=60000

# ── Audit & bot protection ──
AUDIT_BACKEND=memory          # memory | db
IMPOSSIBLE_TRAVEL_MAX_KMH=900

TURNSTILE_ENABLED=false
TURNSTILE_SECRET=
TURNSTILE_FAIL_OPEN=false
TURNSTILE_EXPECTED_ACTION=turnstile-spin-v1
TURNSTILE_EXPECTED_HOSTNAME=
CSP_MODE=off                  # off | report-only | enforce
CSP_REPORT_URI=/api/v1/security/csp-report
CSP_CONNECT_SRC=
CSP_IMG_SRC=https://tiles.openfreemap.org
CSP_SCRIPT_SRC=
CSP_STYLE_SRC=
CSP_FONT_SRC=
CSP_FRAME_SRC=

# ── Worker housekeeping ──
# How often the worker reaps expired sessions and dead link tokens. Expiry is
# already enforced at read time; this only reclaims the rows.
SECURITY_JANITOR_INTERVAL_MS=3600000

# OpenSky Network (OAuth2 client credentials) — fill in later
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_POLL_INTERVAL_MS=6000

# Airspace datasets (real files/URLs are opt-in; do not commit vendor datasets)
AIRSPACE_PROVIDER=mock             # mock | db | openaip | openflightmaps | aixm
AIRSPACE_DB_SOURCE_PROVIDER=openaip
AIRSPACE_DATASET_VERSION=local-fixture
AIRSPACE_IMPORT_BATCH_SIZE=500
AIRSPACE_RETIRE_PREVIOUS_VERSIONS=true
AIRSPACE_RETIRE_MISSING=false
OPENAIP_API_KEY=                   # server-side only; sent as x-openaip-api-key
OPENAIP_GLOBAL_IMPORT=false        # true imports all OpenAIP airspaces; large/rate-limited
OPENAIP_BASE_URL=https://api.core.openaip.net/api
OPENAIP_COUNTRY=                   # e.g. TR; optional when global import is true
OPENAIP_BBOX=                      # minx,miny,maxx,maxy; alternative to country
OPENAIP_PAGE_LIMIT=1000
OPENAIP_IMPORT_PAGE_DELAY_MS=500   # worker/admin import delay between OpenAIP pages
OPENAIP_IMPORT_MAX_RETRIES=5
OPENAIP_DATASET_PATH=
OPENFLIGHTMAPS_DATASET_PATH=
AIXM_DATASET_PATH=

# Airport ground geometry (OpenStreetMap via Overpass; free/open data).
# Run with: cd packages/db && bun run airport-geo:import  (after db:migrate)
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
AIRPORT_OSM_ICAOS=LTFM,LTFJ,LTAC     # comma-separated ICAOs to import
AIRPORT_OSM_RADIUS_M=6000            # metres around each airport
AIRPORT_OSM_DATASET_VERSION=osm-local
# Airport ground-ops engine in the tracker (opt-in, additive). Needs DATABASE_URL
# + imported geometry; emits AirportStateChanged for aircraft near an airport.
AIRPORT_GROUND_ENABLED=true
AIRPORT_GROUND_MAX_KM=8
AIRPORT_GROUND_ALT_FT=10000

# Tracker live feed + stale lifecycle
TRACKER_SOURCE=adsb        # adsb | opensky | composite | fixture
TRACKER_PROVIDERS=opensky,adsb
TRACKER_PROVIDER_PRIORITY=adsb:20,opensky:10
TRACKER_PROVIDER_SWITCH_MARGIN=0.15
TRACKER_PROVIDER_MAX_JUMP_SPEED_KT=1200
TRACKER_BBOX=35.0,25.0,43.0,45.0
TRACKER_LIVE_AFTER_MS=15000
TRACKER_DELAYED_AFTER_MS=30000
TRACKER_STALE_AFTER_MS=60000
TRACKER_REMOVE_AFTER_MS=90000
TRACKER_MAX_POSITION_AGE_MS=30000
ADSB_API_URL=https://api.adsb.lol/v2
ADSB_CENTER_LAT=39.0
ADSB_CENTER_LON=35.0
ADSB_RADIUS_NM=250
ADSB_POLL_INTERVAL_MS=5000
# Tracker Prometheus scrape endpoint (the tracker is otherwise headless).
# Serves GET /metrics (+ /health). 0 disables the server.
TRACKER_METRICS_PORT=9101
TRACKER_METRICS_HOST=0.0.0.0

# Flight operations provider (server-side only)
# Leave scope at "watched" for free-tier quotas; "all" fetches every detected airline flight.
WORKER_PROVIDER_FETCH_SCOPE=watched # watched | all
WORKER_ENABLED_PROVIDERS=aerodatabox           # optional; AERODATABOX_API_KEY auto-enables aerodatabox
AERODATABOX_API_KEY=
AERODATABOX_MARKETPLACE=apimarket   # apimarket | rapidapi
AERODATABOX_BASE_URL=

# Web Push (VAPID) — generate with: bunx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ops@flytrace.local
NOTIFIER_PENDING_CLAIM_IDLE_MS=30000

# Frontend (public)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
NEXT_PUBLIC_TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
