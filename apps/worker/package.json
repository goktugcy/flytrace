{
  "name": "@flytrace/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --target=bun --outdir=dist --sourcemap=linked --minify",
    "start:src": "bun run src/index.ts"
  },
  "dependencies": {
    "@flytrace/airspace": "workspace:*",
    "@flytrace/db": "workspace:*",
    "@flytrace/providers": "workspace:*",
    "@flytrace/shared": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.3"
  }
}
